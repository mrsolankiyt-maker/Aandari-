{
  "version": 2,
  "buildCommand": "mkdir -p dist && cp index.html dist/index.html && cp manifest.webmanifest dist/manifest.webmanifest && cp sw.js dist/sw.js",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
